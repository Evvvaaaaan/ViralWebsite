{
  "redirects": [
    {
      "source": "/",
      "destination": "/percenteme",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/percenteme",
      "destination": "/index.html"
    },
    {
      "source": "/percenteme/(.*)",
      "destination": "/index.html"
    }
  ]
}
